# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real secrets.
#
# Scripts in scripts/ run outside Next.js (triggered by GitHub Actions
# cron workflows) and load this same file via dotenv, so most variables
# below are shared between the app and the scrapers.

# --- Supabase ---------------------------------------------------------
# Anon/public key: safe to ship to the browser, used by the dashboard
# (src/services/jobService.ts) and subject to Row Level Security.
# See supabase/migrations/20261124000000_lock_down_rls.sql for the
# policies that key is expected to be scoped by.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# Service-role key: server-only, bypasses RLS entirely. Used by
# src/lib/supabase-admin.ts (privileged API routes) and scripts/lib/db.mjs
# (the scrapers). Scripts accept either SUPABASE_KEY or
# SUPABASE_SERVICE_ROLE_KEY — set whichever matches your GitHub Actions
# secret naming; SUPABASE_URL is required either way.
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / cron protection --------------------------------------------
# Gates POST /api/profile (resume writes). Pick a long random string.
ADMIN_PASSWORD=
# Bearer token the Vercel/GitHub Actions crons send to authenticate
# against /api/cron/*. Pick a long random string.
CRON_SECRET=

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=
# Where job-alert and scraper-failure emails get sent.
MY_EMAIL=
# Sender used ONLY for POST /api/applications/send (real application emails
# to third-party recruiters). Resend's shared sandbox sender
# (onboarding@resend.dev, used everywhere else in this app) can only
# deliver to your own verified address — sending to anyone else requires
# verifying your own domain in Resend and setting that address here, e.g.
# "Gabriel Ochieng <gabriel@yourdomain.com>". Leave unset and the send
# route will refuse with a clear error instead of failing silently.
APPLICATION_FROM_EMAIL=

# --- AI (Google Gemini) --------------------------------------------------
GEMINI_API_KEY=

# --- Scraping sources -----------------------------------------------------
# Firecrawl (https://firecrawl.dev) — used by most scripts/*-scout.mjs
# and src/app/api/jobs/ai-scout/route.ts for structured page scraping.
FIRECRAWL_API_KEY=
# RapidAPI JSearch — used by src/app/api/cron/api/route.ts.
RAPIDAPI_KEY=
# TheirStack job search API — used by scripts/theirstack-scout.mjs.
THEIRSTACK_API_KEY=
# Logged-in X/Twitter session cookies (semicolon-separated "k=v" pairs),
# used only by scripts/twitter-ghost.mjs.
TWITTER_COOKIES=
